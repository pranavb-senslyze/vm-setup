{
  "version": "1.0.0",
  "description": "Declarative server setup configuration for mise tools",
  "tools": {
    "fzf": {
      "version": "latest",
      "bashrc": []
    },
    "zoxide": {
      "version": "latest",
      "bashrc": [
        "eval \"$(zoxide init bash)\""
      ]
    },
    "ripgrep": {
      "version": "latest",
      "bashrc": []
    }
  },
  "global_bashrc": [
    "# Mise activation - auto-installed by vm-setup",
    "eval \"$(~/.local/bin/mise activate bash)\""
  ]
}
